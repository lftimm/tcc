#!/usr/bin/python3

import subprocess
import argparse
import shutil
import sys
from datetime import datetime
from pathlib import Path

SRC_FILES = ("cuda_cfd.cuf", "interface.f90", "make_vtk.f90")
DATE_FMT = "%d_%m-%H_%M"

def parse_args():
    parser = argparse.ArgumentParser(
        description="Create a new timestamped experiment folder under expr/."
    )
    parser.add_argument(
        "geo_file",
        type=Path,
    )
    parser.add_argument(
        "phys_file",
        type=Path,
    )
    parser.add_argument(
        "interface_dat_file",
        type=Path,
    )
    return parser.parse_args()


def main():
    args = parse_args()
    geo_file = args.geo_file
    phys_file = args.phys_file
    interface_dat_file = args.interface_dat_file

    if geo_file.suffix != ".geo":
        sys.exit(f"error: '{geo_file}' is not a .geo file")
    if not geo_file.is_file():
        sys.exit(f"error: geo file not found: '{geo_file}'")

    if phys_file.suffix != ".phys":
        sys.exit(f"error: '{phys_file}' is not a .phys file")

    if not phys_file.is_file():
        sys.exit(f"error: .phys file not found: '{phys_file}'")

    if interface_dat_file.suffix != ".dat":
        sys.exit(f"error: '{interface_dat_file}' is not a .phys file")

    if not interface_dat_file.is_file():
        sys.exit(f"error: .phys file not found: '{interface_dat_file}'")

    project_root = Path(__file__).resolve().parent
    src_dir = project_root / "src"
    makefile = project_root / "Makefile"
    slurm_file = project_root / "tupi.slurm"
    local_run_file = project_root / "run_local.sh"

    build_vtks = src_dir / "build_vtks.sh"

    for filename in SRC_FILES:
        if not (src_dir / filename).is_file():
            sys.exit(f"error: expected source file missing: '{src_dir / filename}'")
    if not makefile.is_file():
        sys.exit(f"error: Makefile not found: '{makefile}'")

    expr_root = project_root / "expr"
    expr_root.mkdir(exist_ok=True)

    timestamp = datetime.now().strftime(DATE_FMT)
    expr_dir = expr_root / timestamp
    expr_dir.mkdir(parents=True, exist_ok=False)

    exp_src_dir = expr_dir / "src"
    exp_src_dir.mkdir()

    for filename in SRC_FILES:
        shutil.copy(str(src_dir / filename), str(exp_src_dir / filename))

    shutil.copy(makefile, expr_dir / makefile.name)

    shutil.copy(geo_file, expr_dir / "tcc_lt.geo")
    shutil.copy(phys_file, expr_dir / "tcc_lt.phys")
    shutil.copy(interface_dat_file, expr_dir / "INTERFACE.dat")

    shutil.copy(slurm_file, expr_dir / slurm_file.name)
    shutil.copy(build_vtks, expr_dir / build_vtks.name)

    if local_run_file.is_file():
        shutil.copy(local_run_file, expr_dir / local_run_file.name)
        (expr_dir / local_run_file.name).chmod(0o755)

    print(f"experiment created: {expr_dir}")

    subprocess.run(["make", "-C", str(expr_dir), "mesh", "interface"])


if __name__ == "__main__":
    main()
